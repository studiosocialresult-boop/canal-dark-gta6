# Copie este arquivo para .env e preencha. Nunca coloque chaves reais aqui.

# Fase 1 - cerebro e roteiro
ANTHROPIC_API_KEY=

# Fase 2 - narracao
ELEVENLABS_API_KEY=

# Fases 5 e 6 - YouTube
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Fase 5 - Instagram e Facebook (Meta)
META_APP_ID=
META_APP_SECRET=

# Fase 5 - TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Chave que criptografa os acessos das contas conectadas (gerada sozinha na primeira vez).
# Leve junto para a VPS: sem ela, as contas precisam ser conectadas de novo.
CANAL_CHAVE_SECRETA=

# Endereco do painel usado no retorno do login das redes (na VPS, o endereco https dela).
CANAL_URL_PAINEL=http://127.0.0.1:8000

# Fase 7 - avisos no Telegram (o robo e criado no @BotFather; o chat_id e gravado por "python -m app.avisos descobrir")
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Fase 7 - so no computador, depois que o painel principal foi para a VPS: 1 = painel de testes
# (nao publica nem faz a busca diaria, para nada sair em dobro). Nao vai para a VPS.
CANAL_PAINEL_DE_TESTE=

# Fase 7 - so no computador: onde fica a VPS (usado pelo publicar_na_vps.bat)
CANAL_VPS=ubuntu@IP_DA_VPS
CANAL_VPS_CHAVE=~/.ssh/canal_dark_vps
